            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.5.1",
          "rawSql": "SELECT max(c) AS requests\nFROM\n(\n    SELECT user_id, count() AS c\n    FROM remnawave.sub_requests\n    WHERE $__timeFilter(ts)\n    GROUP BY user_id\n)"
