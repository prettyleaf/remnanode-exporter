    {
      "id": 13,
      "type": "table",
      "title": "Refused fetches by rule",
      "description": "Requests a response rule answered with BLOCK, 404, 451 or a dropped socket.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 16,
