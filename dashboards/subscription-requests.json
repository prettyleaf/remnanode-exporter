    {
      "id": 20,
      "type": "table",
      "title": "Subscription-fetch offenders",
      "description": "A real client refreshes a handful of times an hour, from one or two networks, with one User-Agent.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
