      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.5.1",
          "rawSql": "SELECT\n    if(srr_rule_name = '', '(unnamed)', srr_rule_name) AS rule,\n    srr_response_type,\n    count() AS requests,\n    uniqExact(user_id) AS accounts,\n    uniqExact(ua_family) AS clients,\n    max(ts) AS last_seen\nFROM remnawave.v_sub_requests\nWHERE $__timeFilter(ts) AND is_blocked\nGROUP BY rule, srr_response_type\nORDER BY requests DESC\nLIMIT 100"
        }
      ],
