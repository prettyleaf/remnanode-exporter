            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.5.1",
          "rawSql": "SELECT\n    username,\n    status,\n    count() AS requests,\n    uniqExact(ip) AS ips,\n    uniqExact(ip_prefix) AS networks,\n    uniqExact(country) AS countries,\n    uniqExact(user_agent) AS user_agents,\n    countIf(ua_kind IN ('script', 'bot')) AS scripted,\n    countIf(is_hosting = 1) AS from_hosting,\n    countIf(is_blocked) AS refused,\n    max(ts) AS last_seen\nFROM remnawave.v_sub_requests\nWHERE $__timeFilter(ts)\nGROUP BY username, status\nORDER BY requests DESC\nLIMIT 200"
        }
