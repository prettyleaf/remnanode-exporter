          "rawSql": "SELECT\n    $__timeInterval(ts) AS time,\n    ua_kind,\n    count() AS requests\nFROM remnawave.sub_requests\nWHERE $__timeFilter(ts)\nGROUP BY time, ua_kind\nORDER BY time"
