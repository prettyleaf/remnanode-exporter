          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.5.1",
          "rawSql": "SELECT round(100 * countIf(ua_kind IN ('script', 'bot')) / nullIf(count(), 0), 1) AS pct\nFROM remnawave.sub_requests\nWHERE $__timeFilter(ts)"
