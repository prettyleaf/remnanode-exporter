    {
      "id": 11,
      "type": "timeseries",
      "title": "Busiest 10 accounts",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 0,
          "pluginVersion": "4.5.1",
          "rawSql": "SELECT\n    $__timeInterval(s.ts) AS time,\n    if(u.username = '', concat('user-', toString(s.user_id)), u.username) AS username,\n    count() AS requests\nFROM remnawave.sub_requests AS s\nLEFT JOIN remnawave.v_users AS u ON u.user_id = s.user_id\nWHERE $__timeFilter(s.ts)\n  AND s.user_id IN\n  (\n      SELECT user_id\n      FROM remnawave.sub_requests\n      WHERE $__timeFilter(ts)\n      GROUP BY user_id\n      ORDER BY count() DESC\n      LIMIT 10\n  )\nGROUP BY time, username\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            }
          },
