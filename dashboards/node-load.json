    {
      "id": 20,
      "type": "table",
      "title": "Top talkers",
      "description": "peak_mbps is the busiest single 5-minute bucket, so a short burst does not hide behind an hourly average.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 14,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.5.1",
          "rawSql": "SELECT\n    username,\n    any(status) AS status,\n    any(tag) AS tag,\n    sum(bytes) AS total_bytes,\n    round(max(bytes) * 8 / 300 / 1000000, 2) AS peak_mbps,\n    max(nodes) AS nodes,\n    round(100 * sum(bytes) / nullIf((\n        SELECT sum(bytes) FROM remnawave.v_usage WHERE $__timeFilter(ts5) AND node_name IN (${node:sqlstring})\n    ), 0), 2) AS pct_of_total\nFROM\n(\n    SELECT\n        ts5,\n        username,\n        any(status) AS status,\n        any(tag) AS tag,\n        sum(bytes) AS bytes,\n        uniqExact(node_name) AS nodes\n    FROM remnawave.v_usage\n    WHERE $__timeFilter(ts5) AND node_name IN (${node:sqlstring})\n    GROUP BY ts5, username\n)\nGROUP BY username\nORDER BY total_bytes DESC\nLIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "total_bytes"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "peak_mbps"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 50
                    },
                    {
                      "color": "orange",
                      "value": 100
                    },
                    {
                      "color": "red",
                      "value": 200
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "pct_of_total"
            },
            "properties": [
              {
