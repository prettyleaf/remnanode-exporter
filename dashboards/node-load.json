    {
      "id": 6,
      "type": "stat",
      "title": "Traffic per user (p95)",
      "description": "95th percentile of per-user traffic. Anything far above this line is an outlier.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.5.1",
          "rawSql": "SELECT quantileExact(0.95)(b) AS p95\nFROM\n(\n    SELECT user_id, sum(bytes) AS b\n    FROM remnawave.v_usage\n    WHERE $__timeFilter(ts5) AND node_name IN (${node:sqlstring})\n    GROUP BY user_id\n)"
        }
      ],
