          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.5.1",
          "rawSql": "SELECT sum(bytes) AS bytes\nFROM remnawave.v_usage\nWHERE $__timeFilter(ts5) AND node_name IN (${node:sqlstring})"
