    {
      "id": 10,
      "type": "timeseries",
      "title": "Throughput by node",
      "description": "Stacked, so the total height is the whole fleet.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
