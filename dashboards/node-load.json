    {
      "id": 22,
      "type": "table",
      "title": "Top 5 accounts per node",
      "description": "If one account owns most of a node, that is your answer.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.5.1",
          "rawSql": "SELECT\n    node_name,\n    username,\n    bytes,\n    round(100 * bytes / nullIf(sum(bytes) OVER (PARTITION BY node_name), 0), 1) AS pct_of_node\nFROM\n(\n    SELECT node_name, username, sum(bytes) AS bytes\n    FROM remnawave.v_usage\n    WHERE $__timeFilter(ts5) AND node_name IN (${node:sqlstring})\n    GROUP BY node_name, username\n)\nORDER BY node_name ASC, bytes DESC\nLIMIT 5 BY node_name"
