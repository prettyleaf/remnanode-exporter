          "rawSql": "SELECT\n    $__timeInterval(ts5) AS time,\n    username,\n    sum(bytes) * 8 / $__interval_s AS bps\nFROM remnawave.v_usage\nWHERE $__timeFilter(ts5) AND node_name IN (${node:sqlstring})\n  AND user_id IN\n  (\n      SELECT user_id\n      FROM remnawave.v_usage\n      WHERE $__timeFilter(ts5) AND node_name IN (${node:sqlstring})\n      GROUP BY user_id\n      ORDER BY sum(bytes) DESC\n      LIMIT 10\n  )\nGROUP BY time, username\nORDER BY time"
