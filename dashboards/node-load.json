            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 0,
          "pluginVersion": "4.5.1",
          "rawSql": "SELECT\n    $__timeInterval(ts5) AS time,\n    node_name,\n    sum(bytes) * 8 / $__interval_s AS bps\nFROM remnawave.v_usage\nWHERE $__timeFilter(ts5) AND node_name IN (${node:sqlstring})\nGROUP BY time, node_name\nORDER BY time"
        }
      ],
      "fieldConfig": {
