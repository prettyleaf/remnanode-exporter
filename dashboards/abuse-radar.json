    {
      "id": 10,
      "type": "table",
      "title": "Abuse score",
      "description": "score = GB moved + 2 per extra /24 network + 5 per extra country + 2 per extra ASN + 4 per hosting address + 2 per extra User-Agent + 0.2 per subscription fetch over 20 + 0.5 per scripted fetch. Tune it in internal/schema/sql/03_views.sql (v_user_abuse).",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.5.1",
          "rawSql": "SELECT\n    username,\n    status,\n    tag,\n    score,\n    gigabytes,\n    prefixes AS networks,\n    countries,\n    asns,\n    hosting_ips,\n    nodes,\n    ips,\n    sub_requests,\n    sub_uas,\n    hwid_device_limit\nFROM remnawave.v_user_abuse(from = $__fromTime, to = $__toTime)\nWHERE score > 0\nORDER BY score DESC\nLIMIT 200"
        }
