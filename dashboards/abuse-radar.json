          "format": 1,
          "pluginVersion": "4.5.1",
          "rawSql": "SELECT\n    username,\n    node_name,\n    ip,\n    country,\n    city,\n    asn,\n    as_org,\n    max(last_seen) AS last_seen,\n    count() AS snapshots\nFROM remnawave.v_connections\nWHERE $__timeFilter(ts) AND is_hosting = 1\nGROUP BY username, node_name, ip, country, city, asn, as_org\nORDER BY last_seen DESC\nLIMIT 200"
