          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 21,
      "type": "table",
      "title": "Addresses used by more than one account",
      "description": "Different accounts behind one address: either one household, or a resold subscription.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
