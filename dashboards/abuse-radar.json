        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds}"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.5.1",
          "rawSql": "SELECT\n    ip,\n    uniqExact(user_id) AS accounts,\n    arrayStringConcat(groupUniqArray(10)(username), ', ') AS usernames,\n    any(country) AS country,\n    any(as_org) AS as_org,\n    max(is_hosting) AS hosting,\n    max(last_seen) AS last_seen\nFROM remnawave.v_connections\nWHERE $__timeFilter(ts)\nGROUP BY ip\nHAVING accounts > 1\nORDER BY accounts DESC, last_seen DESC\nLIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": {
