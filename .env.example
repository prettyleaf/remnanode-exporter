# ---------------------------------------------------------------------------
# Redis / Valkey — where Remnawave publishes the export streams.
# ---------------------------------------------------------------------------
# The Remnawave compose file starts Valkey with --port 0 and exposes it over a
# unix socket only, so the socket is the normal way in. A Valkey reachable over
# TCP takes redis://user:password@host:6379/0 instead — the username is what
# panels 3.3.0 and newer set through REDIS_USERNAME (Valkey ACL); leave it out
# for a password-only server: redis://:password@host:6379/0
REDIS_URL=unix:///var/run/valkey/valkey.sock

# Consumer group. Every replica of the exporter must share the group name and
# use a distinct consumer name (defaults to the container hostname).
REDIS_GROUP=remnanode-exporter
#REDIS_CONSUMER=exporter-1

# true  — start at the oldest entry still retained (backfills on first run)
# false — start at the newest entry
REDIS_START_FROM_BEGINNING=true

#REDIS_BLOCK=5s
#REDIS_BATCH=500
#REDIS_CLAIM_MIN_IDLE=1m

# ---------------------------------------------------------------------------
# ClickHouse
# ---------------------------------------------------------------------------
CLICKHOUSE_DB=remnawave
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me
#CLICKHOUSE_ADDR=clickhouse:9000

# Address the ClickHouse native port is published on — has to be one your
# Grafana can reach. Never 0.0.0.0.
#   127.0.0.1   Grafana on this host, outside docker
#   172.17.0.1  Grafana in docker on this host (the docker bridge gateway)
#   100.x.x.x   Grafana on another server, over NetBird/WireGuard
CLICKHOUSE_BIND=127.0.0.1

#FLUSH_INTERVAL=5s
#FLUSH_MAX_ROWS=50000

# ---------------------------------------------------------------------------
# MaxMind GeoLite2 — free account at https://www.maxmind.com/en/geolite2/signup
# Without these the pipeline still works, but country/city/ASN stay empty and
# the hosting-provider detection is disabled.
# ---------------------------------------------------------------------------
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
#GEOIP_RELOAD_INTERVAL=6h

# ---------------------------------------------------------------------------
# Remnawave panel — turns numeric ids into names and reports the panel's
# export settings once at startup.
# ---------------------------------------------------------------------------
# API token from the panel (Settings -> API tokens). Resolves both user and
# node ids; /api/nodes only returns the numeric node id on 3.1.0 and newer.
# Without a token the dashboards fall back to user-42 and node-1.
#
# The same token also runs two optional checks once at startup:
#   GET /api/system/metadata      (3.0.0+, scope system:metadata)
#     logs which panel version answers, and warns when it is older than 3.1.0
#   GET /api/system/configuration (3.2.0+, scope system:configuration)
#     warns when the panel is not exporting to the streams at all
# Both are skipped silently when the endpoint or the scope is missing, so a
# token holding only system:read (or nothing but the user and node scopes)
# still works.
REMNAWAVE_API_URL=http://remnawave:3000
REMNAWAVE_API_TOKEN=

#DICT_REFRESH_INTERVAL=5m

# ---------------------------------------------------------------------------
# Attaching to the Remnawave stack
# ---------------------------------------------------------------------------
# The panel's docker-compose-prod.yml declares both the socket volume and the
# network under explicit names, so they carry no compose-project prefix and
# these defaults fit a stock install. Change them only if yours renamed them:
#   docker volume ls | grep valkey && docker network ls | grep remnawave
VALKEY_SOCKET_VOLUME=valkey-socket
REMNAWAVE_NETWORK=remnawave-network

# ---------------------------------------------------------------------------
# Exporter runtime
# ---------------------------------------------------------------------------
# Self-telemetry for vmagent. Port 9102, because the standard Remnawave
# monitoring setup already runs cAdvisor on 9101.
#METRICS_BIND=127.0.0.1
#METRICS_ADDR=:9102
LOG_LEVEL=info
